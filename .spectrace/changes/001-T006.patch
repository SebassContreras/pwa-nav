+/** By id: learned replaces existing, new ones are added, unseen ones are dropped only with `prune`. */
+function mergePatterns(
+  existing: readonly EntityPattern[] = [],
+  learned: readonly EntityPattern[] = [],
+  prune: boolean,
+): EntityPattern[] {
+  const learnedById = new Map(learned.map((p) => [p.id, p]));
+  const out: EntityPattern[] = [];
+  for (const old of existing) {
+    const fresh = learnedById.get(old.id);
+    if (fresh !== undefined) out.push(fresh);
+    else if (!prune) out.push(old);
+  }
+  const existingIds = new Set(existing.map((p) => p.id));
+  for (const p of learned) if (!existingIds.has(p.id)) out.push(p);
+  return out;
+}
