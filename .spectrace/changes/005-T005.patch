diff --git a/src/browser/test/provisioner.test.ts b/src/browser/test/provisioner.test.ts
index 06d3852..fc96283 100644
--- a/src/browser/test/provisioner.test.ts
+++ b/src/browser/test/provisioner.test.ts
@@ -41,4 +41,34 @@ describe("DefaultPwaProvisioner - profile and slug", () => {
       await rm(dir, { recursive: true, force: true });
     }
   });
+
+  it("provisions and delegates launch with port, profile, and appSlug", async () => {
+    let capturedOptions: unknown;
+    const mockLaunch = async (opts: unknown) => {
+      capturedOptions = opts;
+      return {
+        appSlug: "example-com",
+        url: "https://example.com/app",
+        port: 9222,
+        profileDir: "/fake/dir",
+        command: "mock-cmd",
+        pid: 1234,
+      };
+    };
+
+    const provisioner = new DefaultPwaProvisioner({ launchFn: mockLaunch as any });
+    const res = await provisioner.provisionAndLaunch("https://example.com/app", {
+      port: 9222,
+      cacheDir: "test-cache",
+    });
+
+    assert.equal(res.appSlug, "example-com");
+    assert.equal(res.launchResult?.pid, 1234);
+    assert.deepEqual(capturedOptions, {
+      url: "https://example.com/app",
+      appSlug: "example-com",
+      port: 9222,
+      cacheDir: "test-cache",
+    });
+  });
 });
